DATABASE_URL=postgresql://username:password@localhost:5432/smtrack_auth?schema=public
# Both secrets: at least 32 characters, and different from each other (the service refuses to start otherwise).
JWT_SECRET=your-secret-key-change-this-to-something-secure
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-to-something-secure
EXPIRE_TIME=15m
REFRESH_EXPIRE_TIME=7d
PORT=8080
UPLOAD_PATH=http://localhost:3000

# Comma-separated CIDRs/IPs of the proxies in front of this service (KrakenD).
# Requests from these peers are rate-limited by the client in X-Forwarded-For.
TRUSTED_PROXIES=

# Redis Configuration (Optional - for caching)
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# bcrypt work factor for new password hashes (minimum 12).
BCRYPT_COST=12

# How long a soft-deleted record is kept before cmd/purge removes it.
SOFT_DELETE_RETENTION=365d
